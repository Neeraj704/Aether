## 5. The query layer — this is the actual feature you asked for

Create `lib/graph-queries.ts` — pure functions over the normalized state, no components import this directly for rendering; they're for anywhere you want cross-bot analytics (a future admin view, the Creator Dashboard's "popularity" framing, or just answering the question live in dev tools).

```
/** How many bots (across the whole workspace) use this component at all. */
export function botsUsingComponent(state: WorkspaceState, componentId: string): number {
  const botIds = new Set(
    Object.values(state.nodesById)
      .filter((n) => n.componentId === componentId)
      .map((n) => n.botId),
  )
  return botIds.size
}

/** How many bots use this specific model/provider inside a model-select field. */
export function botsUsingModel(state: WorkspaceState, providerId: string, modelId?: string): number {
  const botIds = new Set(
    Object.values(state.nodesById)
      .filter((n) => {
        const model = Object.values(n.config).find(
          (v): v is ModelSelection => typeof v === 'object' && v !== null && 'providerId' in v,
        )
        return model?.providerId === providerId && (!modelId || model.modelId === modelId)
      })
      .map((n) => n.botId),
  )
  return botIds.size
}

/** For a given component, which other components are most often wired directly to it. */
export function coOccurringComponents(state: WorkspaceState, componentId: string, limit = 5) {
  const counts = new Map<string, number>()
  for (const edge of Object.values(state.edgesById)) {
    const source = state.nodesById[edge.source]
    const target = state.nodesById[edge.target]
    if (!source || !target) continue
    if (source.componentId === componentId) counts.set(target.componentId, (counts.get(target.componentId) ?? 0) + 1)
    if (target.componentId === componentId) counts.set(source.componentId, (counts.get(source.componentId) ?? 0) + 1)
  }
  return [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, limit)
}

/** Full usage table — one row per component, for a future "most popular nodes" view anywhere in the app. */
export function componentUsageStats(state: WorkspaceState) {
  const byComponent = new Map<string, { nodeCount: number; botIds: Set<string> }>()
  for (const n of Object.values(state.nodesById)) {
    const entry = byComponent.get(n.componentId) ?? { nodeCount: 0, botIds: new Set() }
    entry.nodeCount += 1
    entry.botIds.add(n.botId)
    byComponent.set(n.componentId, entry)
  }
  return [...byComponent.entries()].map(([componentId, v]) => ({
    componentId,
    nodeCount: v.nodeCount,
    botCount: v.botIds.size,
  }))
}
```

These four functions directly answer the exact questions from your original ask ("how many models use xyz tool, how many xyz tools are connected with abc tool"). **Ship at least one visible use of this layer so it isn't dead code**: the obvious, cheap win is the Component Library page from Phase 5 §4 — add a small "Used in {n} of your bots" line to each component's detail page, computed via `botsUsingComponent`. If Phase 5 hasn't been done yet in your build order, skip the UI hookup for now and just leave the query layer in place with a comment pointing at where it should eventually surface — but write it now regardless, since designing it is the actual point of this phase, wiring it into a specific screen is a five-minute follow-up whenever you get there.

