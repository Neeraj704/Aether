## 6. Migrate existing `localStorage` data, don't wipe it

Anyone who's been testing Phases 4–6 has real (mocked) data sitting in `localStorage` under the old shape. Zustand's `persist` middleware supports exactly this scenario via its `version` + `migrate` options — use them, don't just bump state and let old users silently lose everything:

```
export const useWorkspace = create<WorkspaceState>()(
  persist(
    (set, get) => ({ /* ...new normalized store... */ }),
    {
      name: 'aether-workspace',
      version: 2,   // bump from whatever it is today
      migrate: (persisted: any, version) => {
        if (version < 2) {
          // old shape: persisted.bots is Bot[] with embedded nodes/edges
          const botsById: Record<string, BotMeta> = {}
          const nodesById: Record<string, BotNode & { botId: string }> = {}
          const edgesById: Record<string, BotEdge & { botId: string }> = {}
          const graphIndex: Record<string, { nodeIds: string[]; edgeIds: string[] }> = {}

          for (const bot of persisted.bots ?? []) {
            const { nodes, edges, versions, ...meta } = bot
            botsById[bot.id] = meta
            graphIndex[bot.id] = { nodeIds: nodes.map((n: BotNode) => n.id), edgeIds: edges.map((e: BotEdge) => e.id) }
            for (const n of nodes) nodesById[n.id] = { ...n, botId: bot.id }
            for (const e of edges) edgesById[e.id] = { ...e, botId: bot.id }
          }

          return { ...persisted, botsById, nodesById, edgesById, graphIndex, bots: undefined }
        }
        return persisted
      },
    },
  ),
)
```
Test this by manually setting `localStorage`'s stored version back down (or just testing fresh against whatever's currently in a real browser profile that's been used through Phases 4–6) and confirming bots/graphs survive the upgrade with nothing missing.

