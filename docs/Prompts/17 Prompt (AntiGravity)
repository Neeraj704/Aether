## 5. Task 4 — Wire `TechnicalAnalystNode`

Modify `apps/engine/app/nodes/intelligence_agents/technical_analyst.py`. Keep every line of the existing deterministic RSI/EMA logic exactly as-is through to computing `direction`, `confidence`, `rationale`, `applied_rule` — this becomes your `deterministic_baseline`. After that point, add:

```python
model_config = cfg.get("model", {"providerId": "rule-engine", "modelId": "rsi-ema-momentum-v1", ...})
provider_id = model_config.get("providerId", "rule-engine")

use_llm = (
    provider_id != "rule-engine"
    and ctx.mode in ("paper", "live")
    and ctx.db is not None
    and ctx.user_id is not None
)

llm_audit = {"llm_status": "skipped_mode" if ctx.mode not in ("paper", "live") else "skipped_rule_engine"}

if use_llm:
    cost = LLM_CREDIT_COST.get(f"{provider_id}:{model_config.get('modelId','')}", DEFAULT_LLM_CREDIT_COST)
    has_credits = await check_and_debit_credits(ctx.user_id, cost, ctx.db)
    if not has_credits:
        llm_audit = {"llm_status": "skipped_insufficient_credits", "credits_required": cost}
    else:
        result = await call_llm_for_signal(
            provider_id, model_config.get("modelId", ""),
            system_prompt, feature_summary=<the rsi/ema/macd dict already built>,
            deterministic_baseline={"direction": direction, "confidence": confidence, "rationale": rationale},
            temperature=model_config.get("temperature", 0.4),
            max_tokens=model_config.get("maxTokens", 1024),
        )
        await log_llm_call(ctx, node_component_id="technical-agent", provider=provider_id,
                            model=model_config.get("modelId",""), result=result, credits_charged=cost)
        if result.raw_status == "ok":
            direction, confidence, rationale = result.direction, result.confidence, f"[LLM] {result.rationale}"
            llm_audit = {"llm_status": "ok", "llm_latency_ms": result.latency_ms, "credits_charged": cost}
        else:
            llm_audit = {"llm_status": result.raw_status, "llm_error": result.error_message, "credits_charged": cost}
            # direction/confidence/rationale remain the deterministic baseline — fallback, not failure
```

