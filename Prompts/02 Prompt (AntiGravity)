## 3. Data model reference (do not modify these files — read and consume only)

You will primarily be consuming, not changing, `mock/data.ts` and `lib/workspace-store.ts`. Know these shapes cold before you start:

```ts
// A Bot already has everything needed for the Overview page:
interface Bot {
  id: string
  name: string
  description: string
  status: 'draft' | 'backtested' | 'live' | 'paused' | 'error'
  updatedAt: string
  createdAt: string
  tags: string[]
  nodes: BotNode[]
  edges: BotEdge[]
  headlineMetric: { label: string; value: string; positive: boolean }
  visibility: 'private' | 'unlisted' | 'public'
  versions: BotVersion[]
  runIds: string[]   // <-- this is how a bot's backtest history is tracked
}

// A BacktestRun (what generateBacktest() returns, and what BACKTEST_RUNS holds) has:
interface BacktestRun {
  id: string
  botId: string
  botName: string
  createdAt: string
  config: {
    from: string; to: string; symbols: string; capital: number
    fees: number; slippage: number; seed: number
    type: 'historical' | 'walk-forward' | 'monte-carlo' | 'paper' | 'ab'
  }
  metrics: BacktestMetrics   // totalReturn, winRate, maxDrawdown, sharpe, trades, avgR, profitFactor, exposure
  equity: EquityPoint[]      // { date, equity, benchmark, drawdown }
  trades: Trade[]            // { id, symbol, side, entryTime, exitTime, size, pnl, pnlPct, triggerNode, confidence }
  contributions: LayerContribution[]  // { layer, label, detail, impact, positive }
  insights: { title: string; body: string; kind: 'rule' | 'postmortem' }[]
}
```

The workspace store already exposes everything you need to read and write this data:

```ts
useWorkspace(s => s.bots)                 // all bots
useBot(botId)                             // single bot, or undefined while loading/not found
useWorkspace(s => s.runs)                 // all runs across all bots
useRun(runId)                             // single run, or undefined
useWorkspace(s => s.addRun)               // (run: BacktestRun) => void — call after a "run" completes
useWorkspace(s => s.deleteRun)            // (id: string) => void
useWorkspace(s => s.updateBot)            // (id, patch: Partial<Bot>) => void — for rename/description/visibility
useWorkspace(s => s.deleteBot)            // (id: string) => void — danger zone
useWorkspace(s => s.setBotStatus)         // (id, status) => void
useWorkspace(s => s.snapshotVersion)      // (id, note: string) => void
useHydrated()                             // boolean — gate all reads on this, same pattern as builder pages
```

`addRun()` already updates the bot's `status` (draft → backtested), `updatedAt`, `runIds`, and `headlineMetric` for you. You do not need to call `updateBot()` separately after a run — just call `addRun()` and the bot record updates itself.

To filter a bot's own runs anywhere: `useWorkspace(s => s.runs).filter(r => r.botId === botId)`.

